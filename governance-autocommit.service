[Unit]
Description=governance-autocommit (bigbox)
After=network-online.target

[Service]
Type=simple
Type=oneshot
RestartSec=30
WorkingDirectory=/home/jamesilsley
ExecStart=/bin/bash /home/jamesilsley/.gbrain/governance-autocommit.sh
StandardOutput=append:/home/jamesilsley/.gbrain/governance-autocommit-out.log
StandardError=append:/home/jamesilsley/.gbrain/governance-autocommit-err.log

[Install]
WantedBy=default.target
