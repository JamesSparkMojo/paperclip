[Unit]
Description=merge-flow-deploy-gate-closer (bigbox)
After=network-online.target

[Service]
Type=simple
Type=oneshot
RestartSec=30
WorkingDirectory=/home/jamesilsley/.sparkmojo/platform-main
Environment=SYNC_TREE=/home/jamesilsley/.sparkmojo/platform-main
ExecStart=/bin/bash -lc 'exec /home/jamesilsley/.sparkmojo/monitor-sync-and-run.sh /usr/bin/python3 /home/jamesilsley/.sparkmojo/platform-main/scripts/merge-flow/deploy-gate-closer.py'
StandardOutput=append:/home/jamesilsley/.sparkmojo/merge-flow/deploy-gate-closer-out.log
StandardError=append:/home/jamesilsley/.sparkmojo/merge-flow/deploy-gate-closer-err.log

[Install]
WantedBy=default.target
